# ==============================================================================
# FoodFlow: Environment Configuration Template (Assignment 2)
# Copy this file to .env before running docker compose or local services
# DO NOT COMMIT REAL PASSWORDS OR CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# Common Environment
LOG_LEVEL=INFO
ENVIRONMENT=development

# PostgreSQL Container Credentials (Used by docker-compose and k8s)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_replace_in_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Order Service (Port 8001)
ORDER_SERVICE_HOST=0.0.0.0
ORDER_SERVICE_PORT=8001
ORDER_DB_USER=order_service_user
ORDER_DB_PASSWORD=order_service_pass
ORDER_DB_NAME=order_service_db

# Restaurant Service (Port 8002)
RESTAURANT_SERVICE_HOST=0.0.0.0
RESTAURANT_SERVICE_PORT=8002
RESTAURANT_DB_USER=restaurant_service_user
RESTAURANT_DB_PASSWORD=restaurant_service_pass
RESTAURANT_DB_NAME=restaurant_service_db

# Payment Service (Port 8003)
PAYMENT_SERVICE_HOST=0.0.0.0
PAYMENT_SERVICE_PORT=8003
PAYMENT_DB_USER=payment_service_user
PAYMENT_DB_PASSWORD=payment_service_pass
PAYMENT_DB_NAME=payment_service_db

# Delivery Service (Port 8004)
DELIVERY_SERVICE_HOST=0.0.0.0
DELIVERY_SERVICE_PORT=8004
DELIVERY_DB_USER=delivery_service_user
DELIVERY_DB_PASSWORD=delivery_service_pass
DELIVERY_DB_NAME=delivery_service_db

# Notification Service (Port 8005)
NOTIFICATION_SERVICE_HOST=0.0.0.0
NOTIFICATION_SERVICE_PORT=8005
NOTIFICATION_DB_USER=notification_service_user
NOTIFICATION_DB_PASSWORD=notification_service_pass
NOTIFICATION_DB_NAME=notification_service_db
SIMULATE_NOTIFICATION_FAILURE=false

# Inter-Service Communication URLs (Docker Compose internal network DNS)
RESTAURANT_SERVICE_URL=http://restaurant_service:8002
PAYMENT_SERVICE_URL=http://payment_service:8003
DELIVERY_SERVICE_URL=http://delivery_service:8004
NOTIFICATION_SERVICE_URL=http://notification_service:8005
