{
  "openapi": "3.1.0",
  "info": {
    "title": "FoodFlow - Delivery Service",
    "description": "Manages riders, dispatch, delivery fulfillment, and compensating task cancellations.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Operability"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/deliveries/riders": {
      "get": {
        "tags": [
          "Riders"
        ],
        "summary": "List Riders",
        "description": "List riders, optionally filtering by status.",
        "operationId": "list_riders_api_v1_deliveries_riders_get",
        "parameters": [
          {
            "name": "status_filter",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status Filter"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RiderResponse"
                  },
                  "title": "Response List Riders Api V1 Deliveries Riders Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Riders"
        ],
        "summary": "Register Rider",
        "description": "Register a new delivery rider.",
        "operationId": "register_rider_api_v1_deliveries_riders_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RiderCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiderResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/deliveries/tasks": {
      "post": {
        "tags": [
          "Delivery Tasks"
        ],
        "summary": "Dispatch Delivery",
        "description": "BR5: Rider Allocation Constraint.\nFinds an available rider and atomically assigns the delivery task.\nIf no rider is AVAILABLE, rejects with 409 Conflict.",
        "operationId": "dispatch_delivery_api_v1_deliveries_tasks_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeliveryTaskCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryTaskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/deliveries/tasks/{task_id}/cancel": {
      "post": {
        "tags": [
          "Delivery Tasks"
        ],
        "summary": "Cancel Delivery Task",
        "description": "Saga Compensating Action:\nCancels an assigned delivery task and frees the rider back to AVAILABLE status.",
        "operationId": "cancel_delivery_task_api_v1_deliveries_tasks__task_id__cancel_post",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryTaskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/deliveries/tasks/{task_id}/status": {
      "patch": {
        "tags": [
          "Delivery Tasks"
        ],
        "summary": "Update Task Status",
        "description": "Updates delivery lifecycle (PICKED_UP -> DELIVERED). When DELIVERED, rider returns to AVAILABLE.",
        "operationId": "update_task_status_api_v1_deliveries_tasks__task_id__status_patch",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskStatusUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryTaskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/deliveries/tasks/{task_id}": {
      "get": {
        "tags": [
          "Delivery Tasks"
        ],
        "summary": "Get Task",
        "description": "Retrieve delivery task details.",
        "operationId": "get_task_api_v1_deliveries_tasks__task_id__get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryTaskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/deliveries/tasks/order/{order_id}": {
      "get": {
        "tags": [
          "Delivery Tasks"
        ],
        "summary": "Get Tasks For Order",
        "description": "Retrieve delivery tasks for an order.",
        "operationId": "get_tasks_for_order_api_v1_deliveries_tasks_order__order_id__get",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeliveryTaskResponse"
                  },
                  "title": "Response Get Tasks For Order Api V1 Deliveries Tasks Order  Order Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeliveryTaskCreate": {
        "properties": {
          "order_id": {
            "type": "string",
            "minLength": 1,
            "title": "Order Id"
          },
          "pickup_address": {
            "type": "string",
            "minLength": 1,
            "title": "Pickup Address"
          },
          "delivery_address": {
            "type": "string",
            "minLength": 1,
            "title": "Delivery Address"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "pickup_address",
          "delivery_address"
        ],
        "title": "DeliveryTaskCreate"
      },
      "DeliveryTaskResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "rider_id": {
            "type": "string",
            "title": "Rider Id"
          },
          "pickup_address": {
            "type": "string",
            "title": "Pickup Address"
          },
          "delivery_address": {
            "type": "string",
            "title": "Delivery Address"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "order_id",
          "rider_id",
          "pickup_address",
          "delivery_address",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "DeliveryTaskResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RiderCreate": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "phone": {
            "type": "string",
            "minLength": 5,
            "title": "Phone"
          },
          "vehicle_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vehicle Type",
            "default": "MOTORCYCLE"
          }
        },
        "type": "object",
        "required": [
          "name",
          "phone"
        ],
        "title": "RiderCreate"
      },
      "RiderResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "vehicle_type": {
            "type": "string",
            "title": "Vehicle Type"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "phone",
          "vehicle_type",
          "status",
          "created_at"
        ],
        "title": "RiderResponse"
      },
      "TaskStatusUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "New status: PICKED_UP, DELIVERED, CANCELLED"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "TaskStatusUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}